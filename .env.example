# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=jwcunha
POSTGRES_USER=jwcunha
POSTGRES_PASSWORD=            # generate a long random value

# --- Admin API (HTTP Basic). Leave both empty to keep the admin API locked. ---
ADMIN_USERNAME=
# bcrypt hash, wrapped in SINGLE quotes so Compose does not expand the $ signs. See README "Admin account".
ADMIN_PASSWORD_HASH=

# --- Public site ---
HTTP_PORT=80
PUBLIC_ORIGIN=http://localhost        # origin the site is served from (CORS)
RATE_LIMIT_MAX=5                      # contact submissions per IP per window
RATE_LIMIT_WINDOW_SECONDS=600

# Optional overrides of the public contact details (build-time; empty keeps the built-in value).
# There is deliberately no phone variable: no telephone number is published.
PUBLIC_CONTACT_EMAIL=
PUBLIC_COMPANY_ADDRESS=

# --- E-mail alert for each new proposal request (optional; off by default) ---
# Create an account at an e-mail provider (SMTP), authorise your domain (SPF/DKIM), then fill these in.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_NOTIFY_TO=
# Weekday-morning reminder (08:00 Luanda) listing requests still "New" after this many hours; 0 turns it off.
# Uses the same e-mail settings as above. Empty = 48.
REMINDER_AFTER_HOURS=48
